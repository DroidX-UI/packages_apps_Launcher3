<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:androidprv="http://schemas.android.com/apk/prv/res/android" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/droidx_vertical_padding" android:layout_marginBottom="@dimen/droidx_vertical_padding" android:layout_marginHorizontal="@dimen/droidx_card_side_margin" app:cardCornerRadius="@dimen/droidx_card_radius" app:cardElevation="0dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ui_scrim" android:alpha="0.1"/>
        <LinearLayout android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/droidx_branding_half_height">
            <ImageView 
                android:id="@+id/droidx_branding_image" 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/droidx_branding_image"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:background="?android:attr/colorPrimary" />
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
